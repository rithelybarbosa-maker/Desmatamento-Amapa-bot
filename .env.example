# ============================================================
# CONFIGURAÇÃO DO BOT DE DESMATAMENTO — ESTADO DO AMAPÁ
# ============================================================
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA compartilhe o arquivo .env — ele contém senhas e tokens.

# ─────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────
# Token do bot obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID do grupo dedicado para os alertas de desmatamento
# Formato: número negativo começando com -100 (ex: -1009876543210)
TELEGRAM_CHAT_ID=-1001234567890

# ─────────────────────────────────────────
# CONFIGURAÇÕES OPCIONAIS
# ─────────────────────────────────────────
# Intervalo de verificação em minutos (padrão: 30)
MONITORING_INTERVAL=30

# Fuso horário para exibição das horas nas mensagens
TIMEZONE=America/Belem
